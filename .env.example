# Copy to .env and fill in. Real values must never be committed.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Outgoing email (all site emails are sent from this mailbox)
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-mailbox-password
DJANGO_FROM_EMAIL=Your Brand <noreply@example.com>

# Public address of the site, used for links inside emails
SITE_URL=https://www.example.com

# Razorpay: online payments switch on when both keys are set (use rzp_test_ keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database (PostgreSQL in production; SQLite is used when empty)
DATABASE_URL=

# Seller / legal details printed on invoices and legal pages (leave blank until confirmed)
SELLER_LEGAL_NAME=Volkscure Pvt. Ltd.
SELLER_GSTIN=
SELLER_CIN=
SELLER_LICENCE=
SELLER_ADDRESS=
SELLER_STATE=
SELLER_PINCODE=
GRIEVANCE_NAME=
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=

# Courier (static = estimate only; shiprocket = live API)
COURIER_PROVIDER=static
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
COURIER_WEBHOOK_TOKEN=

# SMS (MSG91) and WhatsApp (Meta Cloud API) order updates and mobile sign-in; each stays off until filled
MSG91_AUTHKEY=
MSG91_TEMPLATE_PLACED=
MSG91_TEMPLATE_STATUS=
MSG91_TEMPLATE_OTP=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_PLACED=
WHATSAPP_TEMPLATE_STATUS=

# Google sign-in (redirect URI: <SITE_URL>/account/google/callback/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin hardening and platform switches
ADMIN_URL=admin
ADMIN_ALLOWED_IPS=
TRUST_PROXY_IP=0
ADMIN_2FA=0
CSP_MODE=enforce
EMAIL_QUEUE=0
SENTRY_DSN=

# Store rules (defaults follow the client brief: online payment only, login to order, no consumer extras)
COD_ENABLED=0
REQUIRE_LOGIN_TO_ORDER=1
CONSUMER_FEATURES=0
